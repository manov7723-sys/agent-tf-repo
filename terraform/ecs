# Configure the AWS Provider
provider "aws" {
  region = "us-west-2"
}

# Create a new VPC
resource "aws_vpc" "example" {
  cidr_block = "10.0.0.0/16"
}

# Create a new subnet
resource "aws_subnet" "example" {
  vpc_id            = aws_vpc.example.id
  cidr_block        = "10.0.1.0/24"
  availability_zone = "us-west-2a"
}

# Create a new ECS cluster
resource "aws_ecs_cluster" "example" {
  name = "example-ecs-cluster"
}

# Create a new ECS task definition
resource "aws_ecs_task_definition" "example" {
  family                = "example-ecs-task-definition"
  network_mode          = "awsvpc"
  requires_compatibilities = ["FARGATE"]
  cpu                      = 256
  memory                  = 512
  execution_role_arn      = aws_iam_role.example.arn
  container_definitions = jsonencode([
    {
      name        = "example-container"
      image       = "nginx:latest"
      cpu         = 10
      essential = true
      portMappings = [
        {
          containerPort = 80
          hostPort      = 80
          protocol      = "tcp"
        }
      ]
    }
  ])
}

# Create a new IAM role for the ECS task execution
resource "aws_iam_role" "example" {
  name        = "example-ecs-task-execution-role"
  description = "ECS task execution role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Principal = {
          Service = "ecs-tasks.amazonaws.com"
        }
        Effect = "Allow"
      }
    ]
  })
}

# Create a new IAM policy for the ECS task execution
resource "aws_iam_policy" "example" {
  name        = "example-ecs-task-execution-policy"
  description = "ECS task execution policy"

  policy      = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = [
          "ecr:GetAuthorizationToken",
          "ecr:BatchGetImage",
          "ecr:GetDownloadUrlForLayer",
          "ecr:BatchCheckLayerAvailability",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ]
        Resource = "*"
        Effect    = "Allow"
      }
    ]
  })
}

# Attach the IAM policy to the IAM role
resource "aws_iam_role_policy_attachment" "example" {
  role       = aws_iam_role.example.name
  policy_arn = aws_iam_policy.example.arn
}
